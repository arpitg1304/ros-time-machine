# Copy to .env (git-ignored) and edit. Applied on top of the chosen profile.

# Where the server listens. 0.0.0.0 = reachable from the LAN; 127.0.0.1 = this machine only.
VLLM_BIND=0.0.0.0
VLLM_PORT=8000

# Require "Authorization: Bearer <key>" on /v1 requests. Strongly recommended when
# VLLM_BIND is 0.0.0.0. The watcher reads it from the env var named in api_key_env.
VLLM_API_KEY=

# Hugging Face token, needed only for gated models (cosmos-reason2-2b).
HF_TOKEN=

# Model downloads are cached here and reused across restarts.
HF_CACHE=${HOME}/.cache/huggingface

# Pinned vLLM image. Upgrade deliberately.
VLLM_IMAGE=vllm/vllm-openai:v0.31.0

# Override any profile value here, e.g. a smaller GPU memory share if a desktop
# session shares the GPU:
# GPU_MEM_UTIL=0.80
