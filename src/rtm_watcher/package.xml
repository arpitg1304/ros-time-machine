<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtm_watcher</name>
  <version>0.2.0</version>
  <description>Semantic triggers for ROS Time Machine: a vision-language model watches a low-rate copy of the cameras and fires time-addressed EventTriggers</description>
  <maintainer email="arpit.wpi@gmail.com">agog13</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ros_time_machine_msgs</depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- quickstart and demo.launch.py start time_machine_node -->
  <exec_depend>ros_time_machine</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Optional: downscaling and raw Image support (either one) -->
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
